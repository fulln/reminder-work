{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reminders.work governed architecture exception",
  "type": "object",
  "additionalProperties": false,
  "required": ["ruleId", "owner", "rationale", "risk", "expiresWhen", "removalTask", "affectedPaths"],
  "properties": {
    "ruleId": { "type": "string", "minLength": 1 },
    "owner": { "type": "string", "minLength": 1 },
    "rationale": { "type": "string", "minLength": 1 },
    "risk": { "type": "string", "minLength": 1 },
    "expiresWhen": { "type": "string", "format": "date" },
    "removalTask": { "type": "string", "minLength": 1 },
    "affectedPaths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  }
}
